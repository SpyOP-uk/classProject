#include "thingProperties.h"
#include <DHT.h>

#define DHTPIN 2        // Data pin connected to DHT22
#define DHTTYPE DHT22   // DHT 22 (AM2302)

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(9600);
  delay(1500); // Allow time for serial monitor
  
  // Initialize cloud properties
  initProperties();

  // Connect to Arduino IoT Cloud
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();

  // Initialize DHT22 sensor
  dht.begin();
}

void loop() {
  ArduinoCloud.update();

  // Read temperature every 2 seconds
  static unsigned long lastRead = 0;
  if (millis() - lastRead > 2000) {
    float t = dht.readTemperature();
    
    if (!isnan(t)) {
      temperature = t; // Update cloud variable
      Serial.print("Temperature: ");
      Serial.print(t);
      Serial.println(" °C");
    } else {
      Serial.println("Failed to read temperature!");
    }
    lastRead = millis();
  }
}

// Required function for the cloud variable
void onTemperatureChange() {
  // Optional: handle dashboard-side changes if needed
}



